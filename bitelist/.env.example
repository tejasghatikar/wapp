# Load order: ../.env.local (wapp) → ./.env.local → ./.env (later files only fill vars not already set).
# Put Twilio + Anthropic here or in wapp/.env.local.

# Server (use 3000 when other app is stopped)
PORT=3000
NODE_ENV=development
PUBLIC_URL=https://your-ngrok-url.ngrok-free.app

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Google Places API (New) — or reuse GOOGLE_MAPS_API_KEY
GOOGLE_PLACES_API_KEY=

# Supabase (service role = server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ALLOW_NEW_USERS=true
LOG_LEVEL=info
