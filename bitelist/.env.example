# Load order: ../.env.local (wapp) → ./.env.local → ./.env (later files only fill vars not already set).
# Never put real secrets in this file — copy to .env.local (local) or Render Environment (prod).

# Server (use 3000 when other app is stopped)
PORT=3000
NODE_ENV=development
PUBLIC_URL=https://your-ngrok-url.ngrok-free.app

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Google Places API (New) — or reuse GOOGLE_MAPS_API_KEY
GOOGLE_PLACES_API_KEY=

# Supabase (service role = server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ALLOW_NEW_USERS=true
LOG_LEVEL=info

# Optional: daily friend-activity digest cron — GET /internal/cron/friend-activity-digest?secret=...
CRON_SECRET=
